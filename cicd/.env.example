# Copy to cicd/.env for local runs (gitignored). In GitHub Actions set the same names as
# variables on each GitHub Environment (dev, prod); real environment variables override this file.

# Foundry project that hosts the agent
FOUNDRY_PROJECT_ENDPOINT=https://<foundry-resource>.services.ai.azure.com/api/projects/<project>

# Knowledge base MCP tool (Foundry IQ / Azure AI Search knowledge base)
KB_SERVER_LABEL=<knowledge-base-server-label>
KB_SERVER_URL=https://<search-service>.search.windows.net/knowledgebases/<knowledge-base>/mcp?api-version=2026-08-01-preview
KB_CONNECTION_ID=<project-connection-name>
