<mxfile host="app.diagrams.net"><diagram id="opg-pipeline" name="Pipeline (GitHub Actions)"><mxGraphModel dx="1600" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1800" pageHeight="1450" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c101" value="&lt;b&gt;OPG · Foundry agent CI/CD pipeline (GitHub Actions) — jobs, reusable deploy workflow and gates&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;fontSize=20;" vertex="1" parent="1"><mxGeometry x="20" y="12" width="1700" height="36" as="geometry"/></mxCell><mxCell id="c102" value="&lt;b&gt;.github/workflows/agent-cicd.yml&lt;/b&gt;&lt;br&gt;Jobs chained with &lt;i&gt;needs:&lt;/i&gt; ci → dev → test → prod&lt;br&gt;Approvals live on GitHub &lt;b&gt;Environments&lt;/b&gt; (dev / test / prod-signoff / prod), not in YAML&lt;br&gt;Azure sign-in: azure/login + OIDC (no secrets)&lt;br&gt;⚠ Private repo: required reviewers need &lt;b&gt;GitHub Enterprise&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#f5f5f5;strokeColor=#666666;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="20" y="62" width="300" height="118" as="geometry"/></mxCell><mxCell id="c103" value="deploy-agents.yml · reusable workflow (workflow_call), ported from the deployV2Agents sample · input: environment" style="swimlane;startSize=28;html=1;rounded=1;fontStyle=1;fontSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;swimlaneFillColor=#f4f8fd;" vertex="1" parent="1"><mxGeometry x="370" y="62" width="1000" height="118" as="geometry"/></mxCell><mxCell id="c104" value="① Resolve MCP server URL&lt;br&gt;(az functionapp show)" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#ffffff;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="385" y="102" width="152" height="64" as="geometry"/></mxCell><mxCell id="c105" value="② Create QSP + LessonPlanning agents (python · private pip feed auth)" 