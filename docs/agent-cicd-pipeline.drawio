metry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c167" value="Failing traces → eval dataset (next release)" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#ffffff;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="1435" y="579" width="270" height="54" as="geometry"/></mxCell><mxCell id="c168" value="" style="endArrow=block;html=1;strokeColor=#999999;" edge="1" parent="1" source="c165" target="c167"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c169" value="Regression,&lt;br&gt;alert or&lt;br&gt;budget hit?" style="rhombus;whiteSpace=wrap;html=1;fontSize=11;fontStyle=1;fillColor=#ffe6cc;strokeColor=#d79b00;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="1465.0" y="655" width="210" height="120" as="geometry"/></mxCell><mxCell id="c170" value="" style="endArrow=block;html=1;strokeColor=#999999;" edge="1" parent="1" source="c167" target="c169"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c171" value="⚠ &lt;b&gt;Inconclusive&lt;/b&gt;: budget_exceeded or too few cases → fix &amp;amp; re-run" style="rounded=1;arcSize=30;whiteSpace=wrap;html=1;fontSize=10;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="378" y="740" width="134" height="62" as="geometry"/></mxCell><mxCell id="c172" value="🔍 &lt;b&gt;Review band&lt;/b&gt;: borderline / flipped cases → Gate 3 evidence" style="rounded=1;arcSize=30;whiteSpace=wrap;html=1;fontSize=10;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="528" y="740" width="134" height="62" as="geometry"/></mxCell><mxCell id="c173" value="⚠ &lt;b&gt;Inconclusive&lt;/b&gt;: budget_exceeded or too few cases → fix &amp;amp; re-run" style="rounded=1;arcSize=30;whiteSpace=wrap;html=1;fontSize=10;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="728" y="740" width="134" height="62" as="geometry"/></mxCell><mxCell id="c174" value="🔍 &lt;b&gt;Review band&lt;/b&gt;: borderline / 