<mxfile host="app.diagrams.net"><diagram id="gates-simple" name="Gates (simple)"><mxGraphModel dx="1600" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1900" pageHeight="1250" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="n2" value="&lt;b style=&quot;font-size:14px&quot;&gt;Code change&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;color:#2e7d32;font-weight:bold;font-size:10px&quot;&gt;● LIVE&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;Purpose&lt;/b&gt;&lt;br&gt;Agent instructions, tools, test questions and pass bars live in Git. Every change is a pull request.&lt;br&gt;&lt;br&gt;&lt;b&gt;When&lt;/b&gt;&lt;br&gt;Every PR&lt;br&gt;&lt;br&gt;&lt;span style=&quot;color:#6a1b9a&quot;&gt;&lt;b&gt;Proposed additions&lt;/b&gt;&lt;br&gt;+ Test set split: shared safety baseline + agent-specific cases&lt;br&gt;+ Runtime policy file (ACS) versioned with hosted agents&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;align=left;verticalAlign=top;spacing=10;fontSize=12;strokeWidth=2;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="40" y="150" width="215" height="440" as="geometry"/></mxCell><mxCell id="n3" value="&lt;b&gt;Question:&lt;/b&gt; Who must review changes to the test questions and pass bars?" style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;verticalAlign=top;spacing=8;fontSize=11;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="40" y="620" width="215" height="80" as="geometry"/></mxCell><mxCell id="n4" value="&lt;b style=&quot;font-size:14px&quot;&gt;Gate 1a · CI checks&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;color:#2e7d32;font-weight:bold;font-size:10px&quot;&gt;● LIVE&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;Purpose&lt;/b&gt;&lt;br&gt;Catch broken changes before anything touches Azure.&lt;br&gt;&lt;br&gt;&lt;b&gt;When&lt;/b&gt;&lt;br&gt;Every PR and merge · ~1 min · free&lt;br&gt;&lt;br&gt;&lt;b&gt;Blocks if&lt;/b&gt;&lt;br&gt;Tests fail, config invalid, test data invalid or not yet reviewed, red-team policy invalid&lt;br&gt;&lt;br&gt;&lt;span style=&quot;color:#6a1b9a&quot;&gt;&lt;b&gt;Proposed additions&lt;/b&gt;&lt;br&gt;+ Validate the runtime policy + its deny/allow test cases (hosted agents)&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;align=left;verticalAlign=top;spacing=10;fontSize=12;strokeWidth=2;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="295" y="150" width="215" height="440" as="geometry"/></mxCell><mxCell id="n5" value="&lt;b&gt;Question:&lt;/b&gt; Any other checks your teams require (security scan, approvals on PR)?" style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;verticalAlign=top;spacing=8;fontSize=11;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="295" y="620" width="215" height="80" as="geometry"/></mxCell><mxCell id="n6" value="&lt;b style=&quot;font-size:14px&quot;&gt;Deploy to dev&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;color:#2e7d32;font-weight:bold;font-size:10px&quot;&gt;● LIVE&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;Purpose&lt;/b&gt;&lt;br&gt;Create a new agent version in the dev Foundry project and smoke-test it.&lt;br&gt;&lt;br&gt;&lt;b&gt;When&lt;/b&gt;&lt;br&gt;Every merge to main · ~1 min&lt;br&gt;&lt;br&gt;&lt;b&gt;Blocks if&lt;/b&gt;&lt;br&gt;Agent does not answer a basic question" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;align=left;verticalAlign=top;spacing=10;fontSize=12;strokeWidth=2;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="550" y="150" width="215" height="440" as="geometry"/></mxCell><mxCell id="n7" value="&lt;b&gt;Question:&lt;/b&gt; Is a new dev version on every merge OK for others using the dev agent?" style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;verticalAlign=top;spacing=8;fontSize=11;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="550" y="620" width="215" height="80" as="geometry"/></mxCell><mxCell id="n8" value="&lt;b style=&quot;font-size:14px&quot;&gt;Gate 1b · Quality evaluation&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;color:#2e7d32;font-weight:bold;font-size:10px&quot;&gt;● LIVE&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;Purpose&lt;/b&gt;&lt;br&gt;Does the agent still do its job and stay in scope?&lt;br&gt;29 test questions: 21 must-pass (scope, authority, prompt injection, safety) + handover quality scored by Foundry evaluators.&lt;br&gt;&lt;br&gt;&lt;b&gt;When&lt;/b&gt;&lt;br&gt;Every merge · ~10-15 min · low cost&lt;br&gt;&lt;br&gt;&lt;b&gt;Blocks if&lt;/b&gt;&lt;br&gt;Any must-pass question fails, a quality score is below its floor, or a question could not run&lt;br&gt;&lt;br&gt;&lt;span style=&quot;color:#6a1b9a&quot;&gt;&lt;b&gt;Proposed additions&lt;/b&gt;&lt;br&gt;+ Groundedness + tool-selection evaluators&lt;br&gt;+ No regression vs. last prod-approved run&lt;br&gt;+ Multi-turn attack suite (ASSERT), advisory first&lt;br&gt;+ Auto-retry transient Azure errors&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;align=left;verticalAlign=top;spacing=10;fontSize=12;strokeWidth=2;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="805" y="150" width="215" height="440" as="geometry"/></mxCell><mxCell id="n9" value="&lt;b&gt;Question:&lt;/b&gt; Are these the right questions and pass bars? Who owns and grows the test set?" style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;verticalAlign=top;spacing=8;fontSize=11;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="805" y="620" width="215" height="80" as="geometry"/></mxCell><mxCell id="n10" value="&lt;b style=&quot;font-size:14px&quot;&gt;Gate 2 · AI red teaming&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;color:#b26a00;font-weight:bold;font-size:10px&quot;&gt;● BUILT, NOT RUN LIVE&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;Purpose&lt;/b&gt;&lt;br&gt;Can an attacker make it misbehave?&lt;br&gt;Foundry AI Red Teaming: 8 risk categories, ~60 automated attacks each.&lt;br&gt;&lt;i&gt;Last manual scan: 92.6% prohibited actions; prompt instructions alone will not fix this.&lt;/i&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;When&lt;/b&gt;&lt;br&gt;Release only (expensive) · reused for 30 days if the agent is unchanged&lt;br&gt;&lt;br&gt;&lt;b&gt;Blocks if&lt;/b&gt;&lt;br&gt;Attack success above limit: 0% prohibited actions and data leakage, 5% other categories&lt;br&gt;&lt;br&gt;&lt;span style=&quot;color:#6a1b9a&quot;&gt;&lt;b&gt;Proposed additions&lt;/b&gt;&lt;br&gt;+ Red-team the agent with its runtime policy on (hosted agents)&lt;br&gt;+ Policy change = new fingerprint = new scan&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;align=left;verticalAlign=top;spacing=10;fontSize=12;strokeWidth=2;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1"><mxGeometry x="1060" y="150" width="215" height="440" as="geometry"/></mxCell><mxCell id="n11" value="&lt;b&gt;Question:&lt;/b&gt; Are these risk limits acceptable to RAI / security? Is a waiver ever allowed, and by whom?" style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;verticalAlign=top;spacing=8;fontSize=11;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="1060" y="620" width="215" height="80" as="geometry"/></mxCell><mxCell id="n12" value="&lt;b style=&quot;font-size:14px&quot;&gt;Gate 3 · Human approval&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;color:#757575;font-weight:bold;font-size:10px&quot;&gt;● NOT CONFIGURED&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;Purpose&lt;/b&gt;&lt;br&gt;An accountable person signs off, with the evaluation and red-team reports on the run page.&lt;br&gt;&lt;br&gt;&lt;b&gt;When&lt;/b&gt;&lt;br&gt;Release only · waits for a named approver (no self-approval)&lt;br&gt;&lt;br&gt;&lt;b&gt;Blocks if&lt;/b&gt;&lt;br&gt;Approver rejects or does not approve&lt;br&gt;&lt;br&gt;&lt;span style=&quot;color:#6a1b9a&quot;&gt;&lt;b&gt;Proposed additions&lt;/b&gt;&lt;br&gt;+ Gate summary posted on the PR / release&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;align=left;verticalAlign=top;spacing=10;fontSize=12;strokeWidth=2;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="1315" y="150" width="215" height="440" as="geometry"/></mxCell><mxCell id="n13" value="&lt;b&gt;Question:&lt;/b&gt; Who approves prod releases? One or two people? Expected turnaround?" style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;verticalAlign=top;spacing=8;fontSize=11;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="1315" y="620" width="215" height="80" as="geometry"/></mxCell><mxCell id="n14" value="&lt;b style=&quot;font-size:14px&quot;&gt;Deploy to prod&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;color:#757575;font-weight:bold;font-size:10px&quot;&gt;● NOT CONFIGURED&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;Purpose&lt;/b&gt;&lt;br&gt;Deploy the exact version that passed, smoke-test it, roll back automatically if it fails.&lt;br&gt;&lt;br&gt;&lt;b&gt;When&lt;/b&gt;&lt;br&gt;After approval&lt;br&gt;&lt;br&gt;&lt;b&gt;Blocks if&lt;/b&gt;&lt;br&gt;Smoke test fails → automatic rollback to previous version&lt;br&gt;&lt;br&gt;&lt;span style=&quot;color:#6a1b9a&quot;&gt;&lt;b&gt;Proposed additions&lt;/b&gt;&lt;br&gt;+ Runtime policy blocks risky tool calls (hosted agents)&lt;br&gt;+ Continuous evaluation + drift alerts&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;align=left;verticalAlign=top;spacing=10;fontSize=12;strokeWidth=2;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="1570" y="150" width="215" height="440" as="geometry"/></mxCell><mxCell id="n15" value="&lt;b&gt;Question:&lt;/b&gt; Where does prod live (separate Foundry resource or project)? What monitoring after go-live?" style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;verticalAlign=top;spacing=8;fontSize=11;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="1570" y="620" width="215" height="80" as="geometry"/></mxCell><mxCell id="n16" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#555555;fontSize=11;fontColor=#555555;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="n2" target="n4"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n17" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#555555;fontSize=11;fontColor=#555555;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="n4" target="n6"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n18" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#555555;fontSize=11;fontColor=#555555;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="n6" target="n8"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n19" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#555555;fontSize=11;fontColor=#555555;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="n8" target="n10"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n20" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#555555;fontSize=11;fontColor=#555555;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="n10" target="n12"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n21" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#555555;fontSize=11;fontColor=#555555;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="n12" target="n14"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n22" value="Every merge to main" style="rounded=1;whiteSpace=wrap;html=1;arcSize=3;dashed=1;fillColor=none;strokeColor=#6c8ebf;verticalAlign=top;align=left;spacing=8;fontStyle=1;fontSize=13;fontColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="25" y="100" width="1010" height="620" as="geometry"/></mxCell><mxCell id="n23" value="Release only (git tag shift-manager-v*)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=3;dashed=1;fillColor=none;strokeColor=#b85450;verticalAlign=top;align=left;spacing=8;fontStyle=1;fontSize=13;fontColor=#b85450;" vertex="1" parent="1"><mxGeometry x="1045" y="100" width="755" height="620" as="geometry"/></mxCell><mxCell id="n24" value="Shift Manager agent: CI/CD gates from code to production (v1.1, for feedback)" style="text;html=1;fontSize=20;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1745" height="40" as="geometry"/></mxCell><mxCell id="n25" value="Microsoft Foundry + GitHub Actions. Every gate fails closed: an error, missing result or too few test cases blocks promotion. Purple items come from recent reviews (ASSERT, Agent Governance Toolkit ACS, AI-Governance-Evaluations)." style="text;html=1;fontSize=12;align=left;verticalAlign=middle;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="40" y="58" width="1745" height="30" as="geometry"/></mxCell><mxCell id="n26" value="Feedback loop: the test set grows from real use" style="rounded=1;whiteSpace=wrap;html=1;arcSize=3;dashed=1;fillColor=none;strokeColor=#2e7d32;verticalAlign=top;align=left;spacing=8;fontStyle=1;fontSize=13;fontColor=#2e7d32;" vertex="1" parent="1"><mxGeometry x="25" y="725" width="1775" height="235" as="geometry"/></mxCell><mxCell id="n27" value="&lt;b&gt;Human review PR&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;color:#2e7d32;font-weight:bold;font-size:10px&quot;&gt;● LIVE&lt;/span&gt;&lt;br&gt;&lt;br&gt;Every drafted case is accepted (edited) or deleted. Gate 1a blocks unreviewed cases." style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;align=left;verticalAlign=top;spacing=10;fontSize=12;strokeWidth=2;fillColor=#e8f5e9;strokeColor=#2e7d32;" vertex="1" parent="1"><mxGeometry x="40" y="760" width="330" height="150" as="geometry"/></mxCell><mxCell id="n28" value="&lt;b&gt;Spec-driven test generation (ASSERT)&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;color:#6a1b9a;font-weight:bold;font-size:10px&quot;&gt;● PROPOSED&lt;/span&gt;&lt;br&gt;&lt;br&gt;Generate single- and multi-turn cases from the agent&#x27;s rules (&quot;never approves work&quot;), plus a shared safety library for every OPG agent." style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;align=left;verticalAlign=top;spacing=10;fontSize=12;strokeWidth=2;fillColor=#f3e5f5;strokeColor=#6a1b9a;dashed=1;" vertex="1" parent="1"><mxGeometry x="410" y="760" width="360" height="150" as="geometry"/></mxCell><mxCell id="n29" value="&lt;b&gt;Weekly trace harvest&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;color:#2e7d32;font-weight:bold;font-size:10px&quot;&gt;● LIVE&lt;/span&gt;&lt;br&gt;&lt;br&gt;Mondays: real conversations → drop test traffic → mask personal data → draft cases from failures and new questions." style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;align=left;verticalAlign=top;spacing=10;fontSize=12;strokeWidth=2;fillColor=#e8f5e9;strokeColor=#2e7d32;" vertex="1" parent="1"><mxGeometry x="810" y="760" width="330" height="150" as="geometry"/></mxCell><mxCell id="n30" value="&lt;b&gt;Production monitoring&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;color:#6a1b9a;font-weight:bold;font-size:10px&quot;&gt;● PROPOSED&lt;/span&gt;&lt;br&gt;&lt;br&gt;Continuous evaluation of live conversations; alert when scores drift below the Gate 1b floors." style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;align=left;verticalAlign=top;spacing=10;fontSize=12;strokeWidth=2;fillColor=#f3e5f5;strokeColor=#6a1b9a;dashed=1;" vertex="1" parent="1"><mxGeometry x="1455" y="760" width="330" height="150" as="geometry"/></mxCell><mxCell id="n31" value="live traffic" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#555555;fontSize=11;fontColor=#555555;labelBackgroundColor=#ffffff;dashed=1;exitX=1;exitY=0.9;exitDx=0;exitDy=0;entryX=1;entryY=0.3;entryDx=0;entryDy=0;" edge="1" parent="1" source="n14" target="n30"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n32" value="failing conversations" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#555555;fontSize=11;fontColor=#555555;labelBackgroundColor=#ffffff;dashed=1;" edge="1" parent="1" source="n30" target="n29"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n33" value="drafts" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#555555;fontSize=11;fontColor=#555555;labelBackgroundColor=#ffffff;dashed=1;" edge="1" parent="1" source="n28" target="n27"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n34" value="PR with drafts" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#555555;fontSize=11;fontColor=#555555;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="n29" target="n27"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n35" value="merged test cases" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#555555;fontSize=11;fontColor=#555555;labelBackgroundColor=#ffffff;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.9;entryDx=0;entryDy=0;" edge="1" parent="1" source="n27" target="n2"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n36" value="&lt;b&gt;Status&lt;/b&gt;&amp;nbsp;&amp;nbsp; &lt;span style=&quot;color:#2e7d32;font-weight:bold;font-size:10px&quot;&gt;● LIVE&lt;/span&gt; &amp;nbsp;·&amp;nbsp; &lt;span style=&quot;color:#b26a00;font-weight:bold;font-size:10px&quot;&gt;● BUILT, NOT RUN LIVE&lt;/span&gt; &amp;nbsp;·&amp;nbsp; &lt;span style=&quot;color:#757575;font-weight:bold;font-size:10px&quot;&gt;● NOT CONFIGURED&lt;/span&gt; &amp;nbsp;·&amp;nbsp; &lt;span style=&quot;color:#6a1b9a;font-weight:bold;font-size:10px&quot;&gt;● PROPOSED&lt;/span&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp; &lt;b&gt;Gate outcomes&lt;/b&gt;&amp;nbsp;&amp;nbsp; &lt;b style=&#x27;color:#2e7d32&#x27;&gt;PASS&lt;/b&gt; continue &amp;nbsp;·&amp;nbsp; &lt;b style=&#x27;color:#b26a00&#x27;&gt;REVIEW&lt;/b&gt; continue, flagged to the approver &amp;nbsp;·&amp;nbsp; &lt;b style=&#x27;color:#555&#x27;&gt;INCONCLUSIVE&lt;/b&gt; blocked, rerun or investigate &amp;nbsp;·&amp;nbsp; &lt;b style=&#x27;color:#b71c1c&#x27;&gt;FAIL&lt;/b&gt; blocked, fix the agent" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fafafa;strokeColor=#cccccc;align=left;spacing=12;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="985" width="1745" height="55" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>