<mxfile host="app.diagrams.net"><diagram id="opg-v1" name="v1 pipeline (GitHub Actions)"><mxGraphModel dx="1600" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1530" pageHeight="1316" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="v501" value="&lt;b&gt;OPG · Foundry agent CI/CD — v1 pipeline (GitHub Actions) · red team only before prod&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;fontSize=20;" vertex="1" parent="1"><mxGeometry x="20" y="12" width="1470" height="36" as="geometry"/></mxCell><mxCell id="v502" value="&lt;b&gt;.github/workflows/agent-cicd.yml&lt;/b&gt;&lt;br&gt;on: pull_request · push (main) · push tags v* · workflow_dispatch (force_redteam)&lt;br&gt;Environments: &lt;b&gt;dev&lt;/b&gt; · &lt;b&gt;prod&lt;/b&gt; (required reviewers) · redteam-waiver (RAI only)&lt;br&gt;azure/login + OIDC · concurrency: dev" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#f5f5f5;strokeColor=#666666;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="20" y="62" width="290" height="118" as="geometry"/></mxCell><mxCell id="v503" value="deploy-agents.yml · reusable deploy workflow (used by dev and prod) · input: environment" style="swimlane;startSize=28;html=1;rounded=1;fontStyle=1;fontSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;swimlaneFillColor=#f4f8fd;" vertex="1" parent="1"><mxGeometry x="360" y="62" width="1130" height="118" as="geometry"/></mxCell><mxCell id="v504" value="① Create agent version &lt;b&gt;from code&lt;/b&gt;&lt;br&gt;agents/&amp;lt;agent&amp;gt;/ + config/agent.{env}.json" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#ffffff;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="380" y="102" width="248" height="64" as="geometry"/></mxCell><mxCell id="v505" value="② &lt;b&gt;Record the version&lt;/b&gt; → job outputs&lt;br&gt;(gates test exactly this version)" style="rounded=1;whiteS