ub issue → back to developer (new PR) · prod keeps the previous version" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="20" y="940" width="1470" height="44" as="geometry"/></mxCell><mxCell id="v564" value="fail" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#b85450;strokeWidth=2;dashed=1;fontColor=#b85450;fontStyle=1;fontSize=11;exitX=0.5;exitY=1;entryX=0.0986;entryY=0;" edge="1" parent="1" source="v526" target="v563"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="v565" value="fail" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#b85450;strokeWidth=2;dashed=1;fontColor=#b85450;fontStyle=1;fontSize=11;exitX=0.5;exitY=1;entryX=0.3367;entryY=0;" edge="1" parent="1" source="v535" target="v563"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="v566" value="fail / inconclusive" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#b85450;strokeWidth=2;dashed=1;fontColor=#b85450;fontStyle=1;fontSize=11;exitX=0.5;exitY=1;entryX=0.6156;entryY=0;" edge="1" parent="1" source="v546" target="v563"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="v567" value="rejected" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#b85450;strokeWidth=2;dashed=1;fontColor=#b85450;fontStyle=1;fontSize=11;exitX=0;exitY=0.5;entryX=0.7946;entryY=0;" edge="1" parent="1" source="v554" target="v563"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1188" y="680.0"/></Array></mxGeometry></mxCell><mxCell id="v568" value="🗺 &lt;b&gt;Not in v1&lt;/b&gt; — v2: test environment (move Gate 2 there) · cost regression + Cost Control budgets · latency gate · bandit   |   v3: statistical no-regression vs prod + review band · separate RAI sign-off · continuous eval · optional monthly prod scan · dashboard" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;align=left;spacingLeft=10;fillColor=#f5f5f5;strokeColor=#999999;" vertex="1" parent="1"><mxGeometry x="20" y="1004" width="1470" height="44" as="geometry"/></mxCell><mxCell id="v569" value="&lt;b&gt;Legend&lt;/b&gt;" style="text;html=1;align=left;fontSize=13;" vertex="1" parent="1"><mxGeometry x="20" y="1076" width="80" height="26" as="geometry"/></mxCell><mxCell id="v570" value="Automated gate&lt;br&gt;(script exits 1)" style="rhombus;whiteSpace=wrap;html=1;fontSize=11;fillColor=#ffe6cc;strokeColor=#d79b00;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="20" y="1106" width="150" height="66" as="geometry"/></mxCell><mxCell id="v571" value="Human gate&lt;br&gt;(GitHub Environment)" style="rhombus;whiteSpace=wrap;html=1;fontSize=11;fillColor=#e1d5e7;strokeColor=#9673a6;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="180" y="1106" width="150" height="66" as="geometry"/></mxCell><mxCell id="v572" value="Uses reusable deploy workflow" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="20" y="1182" width="150" height="40" as="geometry"/></mxCell><mxCell id="v573" value="Cheap safety pre-check" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="180" y="1182" width="150" height="40" as="geometry"/></mxCell><mxCell id="v574" value="Expensive red-team scan" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="20" y="1232" width="150" height="40" as="geometry"/></mxCell><mxCell id="v575" value="Reused result (no cost)" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=2;dashed=1;" vertex="1" parent="1"><mxGeometry x="180" y="1232" width="150" height="40" as="geometry"/></mxCell><mxCell id="v576" value="&lt;table border=&#x27;1&#x27; cellpadding=&#x27;4&#x27; style=&#x27;border-collapse:collapse;font-size:11px;width:100%;&#x27;&gt;&lt;tr style=&#x27;background:#eeeeee;&#x27;&gt;&lt;th&gt;Gate&lt;/th&gt;&lt;th&gt;Runs&lt;/th&gt;&lt;th&gt;Pass rule&lt;/th&gt;&lt;th&gt;Cost / time&lt;/th&gt;&lt;th&gt;Blocks&lt;/th&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;1a&lt;/td&gt;&lt;td&gt;Every PR push&lt;/td&gt;&lt;td&gt;All green · deterministic must-pass = 1.0 · 1 review + CODEOWNERS&lt;/td&gt;&lt;td&gt;~5 min · no model cost&lt;/td&gt;&lt;td&gt;Merge to main&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;1b&lt;/td&gt;&lt;td&gt;Push to main + tag v*&lt;/td&gt;&lt;td&gt;Must-pass cases (incl. 20–30 safety cases) · per-evaluator floors · fail closed&lt;/td&gt;&lt;td&gt;~20 min · small&lt;/td&gt;&lt;td&gt;Release continuing&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;2&lt;/td&gt;&lt;td&gt;Tag v* only, if fingerprint changed / &amp;gt; 30 days / forced&lt;/td&gt;&lt;td&gt;Per-category ASR limits (proposed 0% prohibited actions, ≤ 5% others) · ≥ ~60 attacks per category · fail closed&lt;/td&gt;&lt;td&gt;~1 h · ~420–500 attacks (or reused, 0)&lt;/td&gt;&lt;td&gt;Prod approval&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;3&lt;/td&gt;&lt;td&gt;Per release&lt;/td&gt;&lt;td&gt;Required reviewer approves · no self-approval · main / v* only&lt;/td&gt;&lt;td&gt;Human&lt;/td&gt;&lt;td&gt;Prod deploy&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" style="text;html=1;align=left;verticalAlign=top;overflow=fill;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="350" y="1076" width="1140" height="200" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>