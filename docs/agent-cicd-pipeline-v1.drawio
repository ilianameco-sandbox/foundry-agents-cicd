cc;strokeColor=#b85450;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="730" y="505" width="185" height="80" as="geometry"/></mxCell><mxCell id="v543" value="&lt;b&gt;Reuse last passing scan&lt;/b&gt;&lt;br&gt;same fingerprint · &amp;lt; 30 days&lt;br&gt;no cost" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=2;dashed=1;" vertex="1" parent="1"><mxGeometry x="935" y="505" width="185" height="80" as="geometry"/></mxCell><mxCell id="v544" value="yes" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#b85450;strokeWidth=2;fontColor=#b85450;fontStyle=1;fontSize=11;exitX=0;exitY=0.5;entryX=0.5;entryY=0;" edge="1" parent="1" source="v540" target="v542"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="v545" value="no" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#82b366;strokeWidth=2;fontColor=#2d7600;fontStyle=1;fontSize=11;exitX=1;exitY=0.5;entryX=0.5;entryY=0;" edge="1" parent="1" source="v540" target="v543"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="v546" value="GATE 2&lt;br&gt;per-category limits&lt;br&gt;prohibited = 0 · enough cases" style="rhombus;whiteSpace=wrap;html=1;fontSize=11;fontStyle=1;fillColor=#ffe6cc;strokeColor=#d79b00;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="820.0" y="620" width="210" height="120" as="geometry"/></mxCell><mxCell id="v547" value="" style="endArrow=block;html=1;strokeColor=#999999;exitX=0.5;exitY=1;entryX=0;entryY=0.5;edgeStyle=orthogonalEdgeStyle;" edge="1" parent="1" source="v542" target="v546"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="v548" value="" style="endArrow=block;html=1;strokeColor=#999999;exitX=0.5;exitY=1;entryX=1;entryY=0.5;edgeStyle=orthogonalEdgeStyle;" edge="1" parent="1" source="v543" target="v546"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="v549" value="Today&#x27;s scan would &lt;b&gt;FAIL&lt;/b&gt;:&