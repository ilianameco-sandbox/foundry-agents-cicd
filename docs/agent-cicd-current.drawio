<mxfile host="app.diagrams.net"><diagram id="current" name="Current pipeline"><mxGraphModel dx="1400" dy="900" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1400" pageHeight="840" background="#FFFFFF" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="n2" value="&lt;span style=&quot;font-size:24px;color:#1F2937&quot;&gt;&lt;b&gt;Agent CI/CD&lt;/b&gt;&lt;/span&gt;&lt;span style=&quot;font-size:24px;color:#5B6472;font-weight:300&quot;&gt;  ·  how it runs today&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#5B6472&quot;&gt;Shift Manager agent · GitHub Actions · Foundry dev project &lt;b&gt;opgagentdev&lt;/b&gt; → prod project &lt;b&gt;opgagentprod&lt;/b&gt;&lt;/span&gt;" style="fontFamily=Segoe UI;text;html=1;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="30" y="18" width="900" height="50" as="geometry"/></mxCell><mxCell id="n3" value="&lt;span style=&quot;color:#C53030&quot;&gt;✕&lt;/span&gt; &lt;span style=&quot;color:#5B6472&quot;&gt;blocks the release&lt;/span&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&lt;span style=&quot;color:#2F855A&quot;&gt;✓&lt;/span&gt; &lt;span style=&quot;color:#5B6472&quot;&gt;reusable: skipped if nothing changed (30 days)&lt;/span&gt;" style="fontFamily=Segoe UI;text;html=1;align=right;verticalAlign=middle;fontSize=11;" vertex="1" parent="1"><mxGeometry x="930" y="30" width="440" height="30" as="geometry"/></mxCell><mxCell id="n4" value="" style="fontFamily=Segoe UI;rounded=1;arcSize=3;fillColor=#F4F1FB;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="30" y="86" width="1340" height="170" as="geometry"/></mxCell><mxCell id="n5" value="" style="fontFamily=Segoe UI;rounded=0;fillColor=#6B4FBB;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="30" y="86" width="6" height="170" as="geometry"/></mxCell><mxCell id="n6" value="&lt;div style=&quot;text-align:left&quot;&gt;&lt;span style=&quot;color:#6B4FBB;font-size:26px;font-weight:300&quot;&gt;1&lt;/span&gt;&lt;br&gt;&lt;b style=&quot;color:#1F2937;font-size:14px&quot;&gt;Change the agent&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;color:#5B6472;font-size:11px&quot;&gt;Nothing is deployed yet&lt;/span&gt;&lt;/div&gt;" style="fontFamily=Segoe UI;text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="48" y="100" width="150" height="142" as="geometry"/></mxCell><mxCell id="n7" value="&lt;b&gt;Foundry portal&lt;/b&gt;  →  Promote workflow" style="fontFamily=Segoe UI;rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#6B4FBB;strokeWidth=1;fontColor=#6B4FBB;fontSize=10;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="220" y="108" width="206" height="32" as="geometry"/></mxCell><mxCell id="n8" value="&lt;b&gt;Edit files&lt;/b&gt; in GitHub" style="fontFamily=Segoe UI;rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#6B4FBB;strokeWidth=1;fontColor=#6B4FBB;fontSize=10;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="220" y="155" width="206" height="32" as="geometry"/></mxCell><mxCell id="n9" value="&lt;b&gt;Harvest&lt;/b&gt; real conversations" style="fontFamily=Segoe UI;rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#6B4FBB;strokeWidth=1;fontColor=#6B4FBB;fontSize=10;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="220" y="202" width="206" height="32" as="geometry"/></mxCell><mxCell id="n10" value="&lt;div style=&quot;text-align:left&quot;&gt;&lt;b style=&quot;color:#6B4FBB;font-size:13px&quot;&gt;Pull request&lt;/b&gt;&lt;div style=&quot;color:#5B6472;font-size:11px;line-height:1.35;margin-top:4px&quot;&gt;Reviewer reads the diff,&lt;br&gt;then &lt;b&gt;merges to main&lt;/b&gt;&lt;/div&gt;&lt;/div&gt;" style="fontFamily=Segoe UI;rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#6B4FBB;strokeWidth=1.2;shadow=1;align=left;verticalAlign=top;spacingLeft=14;spacingTop=10;spacingRight=10;" vertex="1" parent="1"><mxGeometry x="452" y="125" width="206" height="98" as="geometry"/></mxCell><mxCell id="n11" value="" style="fontFamily=Segoe UI;edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=blockThin;endFill=1;endSize=7;strokeWidth=1.6;strokeColor=#6B4FBB;fontSize=10;fontColor=#6B4FBB;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.25;entryDx=0;entryDy=0;" edge="1" parent="1" source="n7" target="n10"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n12" value="" style="fontFamily=Segoe UI;edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=blockThin;endFill=1;endSize=7;strokeWidth=1.6;strokeColor=#6B4FBB;fontSize=10;fontColor=#6B4FBB;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="n8" target="n10"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n13" value="" style="fontFamily=Segoe UI;edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=blockThin;endFill=1;endSize=7;strokeWidth=1.6;strokeColor=#6B4FBB;fontSize=10;fontColor=#6B4FBB;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.75;entryDx=0;entryDy=0;" edge="1" parent="1" source="n9" target="n10"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n14" value="&lt;div style=&quot;text-align:left;color:#5B6472;font-size:12px;line-height:1.5&quot;&gt;&lt;b style=&quot;color:#1F2937&quot;&gt;The repo is the source of truth.&lt;/b&gt; The pipeline deploys from &lt;i&gt;cicd/agents/shift-manager&lt;/i&gt;: instructions, tools, test cases and pass bars. It never deploys from the portal.&lt;br&gt;&lt;b style=&quot;color:#1F2937&quot;&gt;Promote&lt;/b&gt; copies a portal version into those files and opens a PR. It stops and explains when a change needs a person: a new model, a dev-only resource or an unsupported setting.&lt;/div&gt;" style="fontFamily=Segoe UI;text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="694" y="112" width="660" height="120" as="geometry"/></mxCell><mxCell id="n15" value="" style="fontFamily=Segoe UI;rounded=1;arcSize=3;fillColor=#EEF4FC;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="30" y="276" width="1340" height="170" as="geometry"/></mxCell><mxCell id="n16" value="" style="fontFamily=Segoe UI;rounded=0;fillColor=#2B6CB0;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="30" y="276" width="6" height="170" as="geometry"/></mxCell><mxCell id="n17" value="&lt;div style=&quot;text-align:left&quot;&gt;&lt;span style=&quot;color:#2B6CB0;font-size:26px;font-weight:300&quot;&gt;2&lt;/span&gt;&lt;br&gt;&lt;b style=&quot;color:#1F2937;font-size:14px&quot;&gt;Test in dev&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;color:#5B6472;font-size:11px&quot;&gt;Every merge to main&lt;br&gt;~15 min · ~2 min if unchanged&lt;/span&gt;&lt;/div&gt;" style="fontFamily=Segoe UI;text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="48" y="290" width="150" height="142" as="geometry"/></mxCell><mxCell id="n18" value="&lt;div style=&quot;text-align:left&quot;&gt;&lt;b style=&quot;color:#2B6CB0;font-size:13px&quot;&gt;Merge to main&lt;/b&gt;&lt;div style=&quot;color:#5B6472;font-size:11px;line-height:1.35;margin-top:4px&quot;&gt;Starts automatically&lt;br&gt;(docs-only changes skip)&lt;/div&gt;&lt;/div&gt;" style="fontFamily=Segoe UI;rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#EEF4FC;strokeColor=#2B6CB0;strokeWidth=1.2;shadow=1;align=left;verticalAlign=top;spacingLeft=14;spacingTop=10;spacingRight=10;" vertex="1" parent="1"><mxGeometry x="220" y="302" width="206" height="98" as="geometry"/></mxCell><mxCell id="n19" value="&lt;div style=&quot;text-align:left&quot;&gt;&lt;b style=&quot;color:#2B6CB0;font-size:13px&quot;&gt;Code checks&lt;/b&gt;&lt;div style=&quot;color:#5B6472;font-size:11px;line-height:1.35;margin-top:4px&quot;&gt;Unit tests, configs build,&lt;br&gt;test set and policies valid&lt;br&gt;~1 min · no Azure&lt;/div&gt;&lt;/div&gt;" style="fontFamily=Segoe UI;rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#2B6CB0;strokeWidth=1.2;shadow=1;align=left;verticalAlign=top;spacingLeft=14;spacingTop=10;spacingRight=10;" vertex="1" parent="1"><mxGeometry x="452" y="302" width="206" height="98" as="geometry"/></mxCell><mxCell id="n20" value="&lt;div style=&quot;text-align:left&quot;&gt;&lt;b style=&quot;color:#2B6CB0;font-size:13px&quot;&gt;Deploy to dev + smoke&lt;/b&gt;&lt;div style=&quot;color:#5B6472;font-size:11px;line-height:1.35;margin-top:4px&quot;&gt;New version only if changed&lt;br&gt;2 quick questions, incl. a&lt;br&gt;cited document answer&lt;/div&gt;&lt;/div&gt;" style="fontFamily=Segoe UI;rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#2B6CB0;strokeWidth=1.2;shadow=1;align=left;verticalAlign=top;spacingLeft=14;spacingTop=10;spacingRight=10;" vertex="1" parent="1"><mxGeometry x="684" y="302" width="206" height="98" as="geometry"/></mxCell><mxCell id="n21" value="&lt;div style=&quot;text-align:left&quot;&gt;&lt;b style=&quot;color:#2B6CB0;font-size:13px&quot;&gt;Evaluation&lt;/b&gt;&lt;div style=&quot;color:#5B6472;font-size:11px;line-height:1.35;margin-top:4px&quot;&gt;21 must-pass cases: 100%&lt;br&gt;94 document questions:&lt;br&gt;correct ≥90% · cited ≥85%&lt;br&gt;safe 100%&lt;/div&gt;&lt;/div&gt;" style="fontFamily=Segoe UI;rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#2B6CB0;strokeWidth=1.2;shadow=1;align=left;verticalAlign=top;spacingLeft=14;spacingTop=10;spacingRight=10;" vertex="1" parent="1"><mxGeometry x="916" y="302" width="206" height="98" as="geometry"/></mxCell><mxCell id="n22" value="&lt;div style=&quot;text-align:left&quot;&gt;&lt;b style=&quot;color:#2F855A;font-size:13px&quot;&gt;Dev updated ✓&lt;/b&gt;&lt;div style=&quot;color:#5B6472;font-size:11px;line-height:1.35;margin-top:4px&quot;&gt;Stops here unless&lt;br&gt;it&#x27;s a release&lt;/div&gt;&lt;/div&gt;" style="fontFamily=Segoe UI;rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#E8F5EC;strokeColor=#2F855A;strokeWidth=1.2;shadow=1;align=left;verticalAlign=top;spacingLeft=14;spacingTop=10;spacingRight=10;" vertex="1" parent="1"><mxGeometry x="1148" y="302" width="206" height="98" as="geometry"/></mxCell><mxCell id="n23" value="&lt;b&gt;1a&lt;/b&gt;" style="fontFamily=Segoe UI;ellipse;whiteSpace=wrap;html=1;fillColor=#2B6CB0;strokeColor=#FFFFFF;strokeWidth=2;fontColor=#FFFFFF;fontSize=11;align=center;verticalAlign=middle;shadow=1;" vertex="1" parent="1"><mxGeometry x="440" y="290" width="30" height="30" as="geometry"/></mxCell><mxCell id="n24" value="&lt;b&gt;1b&lt;/b&gt;" style="fontFamily=Segoe UI;ellipse;whiteSpace=wrap;html=1;fillColor=#2B6CB0;strokeColor=#FFFFFF;strokeWidth=2;fontColor=#FFFFFF;fontSize=11;align=center;verticalAlign=middle;shadow=1;" vertex="1" parent="1"><mxGeometry x="904" y="290" width="30" height="30" as="geometry"/></mxCell><mxCell id="n25" value="" style="fontFamily=Segoe UI;edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=blockThin;endFill=1;endSize=7;strokeWidth=1.6;strokeColor=#2B6CB0;fontSize=10;fontColor=#2B6CB0;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="n18" target="n19"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n26" value="" style="fontFamily=Segoe UI;edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=blockThin;endFill=1;endSize=7;strokeWidth=1.6;strokeColor=#2B6CB0;fontSize=10;fontColor=#2B6CB0;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="n19" target="n20"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n27" value="" style="fontFamily=Segoe UI;edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=blockThin;endFill=1;endSize=7;strokeWidth=1.6;strokeColor=#2B6CB0;fontSize=10;fontColor=#2B6CB0;labelBackgroundColor=#ffffff;" edge="1" parent="1