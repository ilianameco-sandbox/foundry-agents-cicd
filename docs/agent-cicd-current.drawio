<mxfile host="app.diagrams.net"><diagram id="current" name="Current pipeline"><mxGraphModel dx="1400" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1380" pageHeight="1020" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="n2" value="&lt;span style=&quot;font-size:20px&quot;&gt;&lt;b&gt;Shift Manager agent CI/CD: how it runs today&lt;/b&gt;&lt;/span&gt;&lt;span style=&quot;font-size:12px;color:#666666&quot;&gt;   repo ilianameco-sandbox/foundry-agents-cicd · dev project opgagentdev → prod project opgagentprod&lt;/span&gt;" style="text;html=1;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1300" height="40" as="geometry"/></mxCell><mxCell id="n3" value="1  Change the agent (nothing is deployed yet)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=2;fillColor=none;strokeColor=#bbbbbb;dashed=1;strokeWidth=1;align=left;verticalAlign=top;spacingLeft=12;spacingTop=6;fontSize=13;fontStyle=1;fontColor=#888888;" vertex="1" parent="1"><mxGeometry x="30" y="75" width="1310" height="175" as="geometry"/></mxCell><mxCell id="n4" value="&lt;b&gt;Build in Foundry portal&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;dev project only&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;align=center;verticalAlign=middle;spacing=8;fontSize=12;strokeWidth=2;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="60" y="115" width="210" height="50" as="geometry"/></mxCell><mxCell id="n5" value="&lt;b&gt;Promote portal agent&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;Actions → Run workflow → version&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;align=center;verticalAlign=middle;spacing=8;fontSize=12;strokeWidth=2;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="310" y="115" width="230" height="50" as="geometry"/></mxCell><mxCell id="n6" value="&lt;b&gt;Edit files in GitHub&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;instructions, tools, tests, pass bars&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;align=center;verticalAlign=middle;spacing=8;fontSize=12;strokeWidth=2;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="60" y="185" width="210" height="50" as="geometry"/></mxCell><mxCell id="n7" value="&lt;b&gt;Harvest real conversations&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;optional · new test cases&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;align=center;verticalAlign=middle;spacing=8;fontSize=12;strokeWidth=2;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="310" y="185" width="230" height="50" as="geometry"/></mxCell><mxCell id="n8" value="&lt;b&gt;Pull request&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;review the diff → &lt;b&gt;merge to main&lt;/b&gt;&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;align=center;verticalAlign=middle;spacing=8;fontSize=12;strokeWidth=2;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="600" y="140" width="230" height="70" as="geometry"/></mxCell><mxCell id="n9" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#555555;fontSize=11;fontColor=#555555;labelBackgroundColor=#ffffff;fontStyle=1;" edge="1" parent="1" source="n4" target="n5"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n10" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#555555;fontSize=11;fontColor=#555555;labelBackgroundColor=#ffffff;fontStyle=1;" edge="1" parent="1" source="n5" target="n8"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n11" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#555555;fontSize=11;fontColor=#555555;labelBackgroundColor=#ffffff;fontStyle=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.25;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="n6" target="n8"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="165" y="244"/><mxPoint x="657" y="244"/></Array></mxGeometry></mxCell><mxCell id="n12" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#555555;fontSize=11;fontColor=#555555;labelBackgroundColor=#ffffff;fontStyle=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.75;entryDx=0;entryDy=0;" edge="1" parent="1" source="n7" target="n8"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n13" value="&lt;b&gt;The repo is the source of truth&lt;/b&gt;&lt;br&gt;The pipeline deploys from &lt;i&gt;cicd/agents/shift-manager&lt;/i&gt; (agent.json, instructions.md, configs, eval/), never from the portal.&lt;br&gt;&lt;br&gt;&lt;b&gt;Promote&lt;/b&gt; copies a portal version into those files and opens a PR. It refuses to guess (new model, dev-only resource, unsupported setting)." style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;verticalAlign=top;spacing=10;fontSize=11;fillColor=#ffffff;strokeColor=#999999;" vertex="1" parent="1"><mxGeometry x="880" y="105" width="440" height="130" as="geometry"/></mxCell><mxCell id="n14" value="2  Every merge to main: test in dev (~15 min, or ~2 min if nothing changed)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=2;fillColor=none;strokeColor=#bbbbbb;dashed=1;strokeWidth=1;align=left;verticalAlign=top;spacingLeft=12;spacingTop=6;fontSize=13;fontStyle=1;fontColor=#888888;" vertex="1" parent="1"><mxGeometry x="30" y="265" width="1310" height="175" as="geometry"/></mxCell><mxCell id="n15" value="&lt;b&gt;Merge to main&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;automatic&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;align=center;verticalAlign=middle;spacing=8;fontSize=12;strokeWidth=2;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="60" y="320" width="150" height="70" as="geometry"/></mxCell><mxCell id="n16" value="&lt;b&gt;Gate 1a · Code checks&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;unit tests, configs render, test set + red-team policy + smoke checks valid&lt;br&gt;~1 min · no Azure&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;align=center;verticalAlign=middle;spacing=8;fontSize=12;strokeWidth=2;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="250" y="305" width="220" height="100" as="geometry"/></mxCell><mxCell id="n17" value="&lt;b&gt;Deploy to dev + smoke&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;new version only if agent changed&lt;br&gt;2 checks: general answer + GQ-067 must say SAG-7 with citation&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;align=center;verticalAlign=middle;spacing=8;fontSize=12;strokeWidth=2;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="510" y="305" width="230" height="100" as="geometry"/></mxCell><mxCell id="n18" value="&lt;b&gt;Gate 1b · Evaluation&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;21 must-pass behaviour cases: 100%&lt;br&gt;94 document questions: correct ≥90% · cited ≥85% · safe 100%&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;align=center;verticalAlign=middle;spacing=8;fontSize=12;strokeWidth=2;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="780" y="305" width="250" height="100" as="geometry"/></mxCell><mxCell id="n19" value="&lt;b&gt;Dev updated&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;stops here unless it&#x27;s a release&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;align=center;verticalAlign=middle;spacing=8;fontSize=12;strokeWidth=2;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="1080" y="320" width="230" height="70" as="geometry"/></mxCell><mxCell id="n20" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#555555;fontSize=11;fontColor=#555555;labelBackgroundColor=#ffffff;fontStyle=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="n8" target="n15"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="715" y="257"/><mxPoint x="135" y="257"/></Array></mxGeometry></mxCell><mxCell id="n21" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#555555;fontSize=11;fontColor=#555555;labelBackgroundColor=#ffffff;fontStyle=1;" edge="1" parent="1" source="n15" target="n16"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n22" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#555555;fontSize=11;fontColor=#555555;labelBackgroundColor=#ffffff;fontStyle=1;" edge="1" parent="1" source="n16" target="n17"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n23" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#555555;fontSize=11;fontColor=#555555;labelBackgroundColor=#ffffff;fontStyle=1;" edge="1" parent="1" source="n17" target="n18"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n24" value="pass" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#555555;fontSize=11;fontColor=#555555;labelBackgroundColor=#ffffff;fontStyle=1;" edge="1" parent="1" source="n18" target="n19"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n25" value="3  Release: create tag shift-manager-vX.Y.Z → prod (~1-1.5 h, minutes if reused)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=2;fillColor=none;strokeColor=#bbbbbb;dashed=1;strokeWidth=1;align=left;verticalAlign=top;spacingLeft=12;spacingTop=6;fontSize=13;fontStyle=1;fontColor=#888888;" vertex="1" parent="1"><mxGeometry x="30" y="455" width="1310" height="345" as="geometry"/></mxCell><mxCell id="n26" value="&lt;b&gt;Release tag&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;GitHub → Releases → new tag&lt;br&gt;when dev looks good&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;align=center;verticalAlign=middle;spacing=8;fontSize=12;strokeWidth=2;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="60" y="505" width="150" height="80" as="geometry"/></mxCell><mxCell id="n27" value="&lt;b&gt;Gates 1a, dev, 1b&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;same as lane 2 on the tagged commit&lt;br&gt;(evaluation reused if unchanged)&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;align=center;verticalAlign=middle;spacing=8;fontSize=12;strokeWidth=2;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="250" y="500" width="220" height="90" as="geometry"/></mxCell><mxCell id="n28" value="&lt;b&gt;Gate 2 · AI red teaming&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;~110 attack conversations (Flip, Base64, 5 turns)&lt;br&gt;0% prohibited-action success&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;align=center;verticalAlign=middle;spacing=8;fontSize=12;strokeWidth=2;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="510" y="500" width="230" height="90" as="geometry"/></mxCell><mxCell id="n29" value="&lt;b&gt;Approval packet&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;GitHub issue + run summary + HTML&lt;br&gt;results, failing cases, flags&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;align=center;verticalAlign=middle;spacing=8;fontSize=12;strokeWidth=2;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="780" y="500" width="250" height="90" as="geometry"/></mxCell><mxCell id="n30" value="&lt;b&gt;Gate 3 · Human approval&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;prod reviewer reads the packet&lt;br&gt;Approve or Reject + comment&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;align=center;verticalAlign=middle;spacing=8;fontSize=12;strokeWidth=2;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="1080" y="500" width="230" height="90" as="geometry"/></mxCell><mxCell id="n31" value="happy? release" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#888888;fontSize=11;fontColor=#888888;labelBackgroundColor=#ffffff;fontStyle=1;dashed=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="n19" target="n26"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1195" y="445"/><mxPoint x="135" y="445"/></Array></mxGeometry></mxCell><mxCell id="n32" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#555555;fontSize=11;fontColor=#555555;labelBackgroundColor=#ffffff;fontStyle=1;" edge="1" parent="1" source="n26" target="n27"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n33" value="pass" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#555555;fontSize=11;fontColor=#555555;labelBackgroundColor=#ffffff;fontStyle=1;" edge="1" parent="1" source="n27" target="n28"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n34" value="pass / review" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#555555;fontSize=11;fontColor=#555555;labelBackgroundColor=#ffffff;fontStyle=1;" edge="1" parent="1" source="n28" target="n29"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n35" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#555555;fontSize=11;fontColor=#555555;labelBackgroundColor=#ffffff;fontStyle=1;" edge="1" parent="1" source="n29" target="n30"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n36" value="&lt;b&gt;Deploy to prod + smoke&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;same agent definition (fingerprint)&lt;br&gt;same 2 smoke checks&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;align=center;verticalAlign=middle;spacing=8;fontSize=12;strokeWidth=2;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="1080" y="700" width="230" height="80" as="geometry"/></mxCell><mxCell id="n37" value="&lt;b&gt;Live in prod&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;opgagentprod&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;align=center;verticalAlign=middle;spacing=8;fontSize=12;strokeWidth=2;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="780" y="700" width="250" height="80" as="geometry"/></mxCell><mxCell id="n38" value="approve" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#2e7d32;fontSize=11;fontColor=#2e7d32;labelBackgroundColor=#ffffff;fontStyle=1;" edge="1" parent="1" source="n30" target="n36"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n39" value="pass" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#2e7d32;fontSize=11;fontColor=#2e7d32;labelBackgroundColor=#ffffff;fontStyle=1;" edge="1" parent="1" source="n36" target="n37"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n40" value="&lt;b&gt;Blocked: nothing reaches prod&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;packet explains why → fix the agent or a wrong test → new PR / new tag&lt;br&gt;prod smoke fails → automatic rollback to previous prod version&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;align=center;verticalAlign=middle;spacing=8;fontSize=12;strokeWidth=2;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1"><mxGeometry x="250" y="700" width="490" height="80" as="geometry"/></mxCell><mxCell id="n41" value="fail" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#b85450;fontSize=11;fontColor=#b85450;labelBackgroundColor=#ffffff;fontStyle=1;dashed=1;exitX=0.25;exitY=1;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="n18" target="n40"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="842" y="425"/><mxPoint x="230" y="425"/><mxPoint x="230" y="740"/></Array></mxGeometry></mxCell><mxCell id="n42" value="fail" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#b85450;fontSize=11;fontColor=#b85450;labelBackgroundColor=#ffffff;fontStyle=1;dashed=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.765;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="n28" target="n40"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n43" value="reject" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#b85450;fontSize=11;fontColor=#b85450;labelBackgroundColor=#ffffff;fontStyle=1;dashed=1;exitX=0;exitY=1;exitDx=0;exitDy=0;entryX=1;entryY=0.25;entryDx=0;entryDy=0;" edge="1" parent="1" source="n30" target="n40"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1080" y="680"/><mxPoint x="760" y="680"/><mxPoint x="760" y="720"/></Array></mxGeometry></mxCell><mxCell id="n44" value="rollback" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#b85450;fontSize=11;fontColor=#b85450;labelBackgroundColor=#ffffff;fontStyle=1;dashed=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="n36" target="n40"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1195" y="820"/><mxPoint x="495" y="820"/></Array></mxGeometry></mxCell><mxCell id="n45" value="&lt;b&gt;Not paying twice&lt;/b&gt; (reuse when nothing changed)&lt;br&gt;• Dev version: kept if definition + model are identical&lt;br&gt;• Evaluation: reused for 30 days if agent, test cases, pass bars and judges are identical&lt;br&gt;• Red-team scan: reused for 30 days if agent and red-team policy are identical&lt;br&gt;• Force a fresh run: &lt;i&gt;Run workflow&lt;/i&gt; with &lt;b&gt;force_eval&lt;/b&gt; / &lt;b&gt;force_redteam&lt;/b&gt;&lt;br&gt;• Docs-only changes don&#x27;t trigger the pipeline" style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;verticalAlign=top;spacing=10;fontSize=11;fillColor=#ffffff;strokeColor=#999999;" vertex="1" parent="1"><mxGeometry x="30" y="845" width="640" height="150" as="geometry"/></mxCell><mxCell id="n46" value="&lt;b&gt;Rules that keep it safe&lt;/b&gt;&lt;br&gt;• Fail closed: errors, missing results or too few cases block, never pass&lt;br&gt;• A judge error (e.g. rate limit) is re-scored, max 2 times; a real miss is &lt;b&gt;not&lt;/b&gt; retried&lt;br&gt;• Red team only on releases; REVIEW = passes but flagged for the approver&lt;br&gt;• Prod: required reviewer, no admin bypass, only shift-manager-v* tags, OIDC (no secrets in code)&lt;br&gt;• Manual &lt;i&gt;Run workflow&lt;/i&gt; + force_redteam builds a packet but never deploys prod" style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;verticalAlign=top;spacing=10;fontSize=11;fillColor=#ffffff;strokeColor=#999999;" vertex="1" parent="1"><mxGeometry x="700" y="845" width="640" height="150" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>