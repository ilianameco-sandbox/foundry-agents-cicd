<mxfile host="app.diagrams.net"><diagram id="target" name="Target design"><mxGraphModel dx="1400" dy="1000" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1400" pageHeight="1070" background="#FFFFFF" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="n2" value="&lt;span style=&quot;font-size:24px;color:#1F2937&quot;&gt;&lt;b&gt;Agent CI/CD&lt;/b&gt;&lt;/span&gt;&lt;span style=&quot;font-size:24px;color:#5B6472;font-weight:300&quot;&gt;  ·  target design&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#5B6472&quot;&gt;Generic Microsoft Foundry agent release pipeline · dev → test/UAT → prod · secure, authorized, compliant and approved&lt;/span&gt;" style="fontFamily=Segoe UI;text;html=1;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="30" y="18" width="900" height="50" as="geometry"/></mxCell><mxCell id="n3" value="&lt;span style=&quot;color:#B7791F&quot;&gt;★&lt;/span&gt; &lt;span style=&quot;color:#5B6472&quot;&gt;new vs today&lt;/span&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&lt;span style=&quot;color:#C53030&quot;&gt;✕&lt;/span&gt; &lt;span style=&quot;color:#5B6472&quot;&gt;blocks the release&lt;/span&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&lt;b style=&quot;color:#5B6472&quot;&gt;G1–G6&lt;/b&gt; &lt;span style=&quot;color:#5B6472&quot;&gt;gates&lt;/span&gt;" style="fontFamily=Segoe UI;text;html=1;align=right;verticalAlign=middle;fontSize=11;" vertex="1" parent="1"><mxGeometry x="900" y="30" width="470" height="30" as="geometry"/></mxCell><mxCell id="n4" value="" style="fontFamily=Segoe UI;rounded=1;arcSize=3;fillColor=#F4F1FB;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="30" y="86" width="1340" height="180" as="geometry"/></mxCell><mxCell id="n5" value="" style="fontFamily=Segoe UI;rounded=0;fillColor=#6B4FBB;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="30" y="86" width="6" height="180" as="geometry"/></mxCell><mxCell id="n6" value="&lt;div style=&quot;text-align:left&quot;&gt;&lt;span style=&quot;color:#6B4FBB;font-size:26px;font-weight:300&quot;&gt;1&lt;/span&gt;&lt;br&gt;&lt;b style=&quot;color:#1F2937;font-size:14px&quot;&gt;Change the agent&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;color:#5B6472;font-size:11px&quot;&gt;Agent, test cases and customer rules live in Git&lt;/span&gt;&lt;/div&gt;" style="fontFamily=Segoe UI;text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="48" y="100" width="150" height="152" as="geometry"/></mxCell><mxCell id="n7" value="&lt;b&gt;Foundry portal&lt;/b&gt;  →  Promote workflow" style="fontFamily=Segoe UI;rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#6B4FBB;strokeWidth=1;fontColor=#6B4FBB;fontSize=10;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="220" y="106" width="206" height="32" as="geometry"/></mxCell><mxCell id="n8" value="&lt;b&gt;Edit files&lt;/b&gt; in GitHub" style="fontFamily=Segoe UI;rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#6B4FBB;strokeWidth=1;fontColor=#6B4FBB;fontSize=10;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="220" y="156" width="206" height="32" as="geometry"/></mxCell><mxCell id="n9" value="&lt;b&gt;Harvest&lt;/b&gt; conversations + UAT 👎" style="fontFamily=Segoe UI;rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#6B4FBB;strokeWidth=1;fontColor=#6B4FBB;fontSize=10;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="220" y="206" width="206" height="32" as="geometry"/></mxCell><mxCell id="n10" value="&lt;div style=&quot;text-align:left&quot;&gt;&lt;b style=&quot;color:#6B4FBB;font-size:13px&quot;&gt;Pull request&lt;/b&gt;&lt;div style=&quot;color:#5B6472;font-size:11px;line-height:1.35;margin-top:4px&quot;&gt;Reviewer reads the diff&lt;br&gt;(instructions, tests, rules)&lt;br&gt;then &lt;b&gt;merges to main&lt;/b&gt;&lt;/div&gt;&lt;/div&gt;" style="fontFamily=Segoe UI;rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#6B4FBB;strokeWidth=1.2;shadow=1;align=left;verticalAlign=top;spacingLeft=14;spacingTop=10;spacingRight=10;" vertex="1" parent="1"><mxGeometry x="452" y="126" width="206" height="98" as="geometry"/></mxCell><mxCell id="n11" value="" style="fontFamily=Segoe UI;edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=blockThin;endFill=1;endSize=7;strokeWidth=1.6;strokeColor=#6B4FBB;fontSize=10;fontColor=#6B4FBB;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.25;entryDx=0;entryDy=0;" edge="1" parent="1" source="n7" target="n10"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n12" value="" style="fontFamily=Segoe UI;edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=blockThin;endFill=1;endSize=7;strokeWidth=1.6;strokeColor=#6B4FBB;fontSize=10;fontColor=#6B4FBB;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="n8" target="n10"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n13" value="" style="fontFamily=Segoe UI;edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=blockThin;endFill=1;endSize=7;strokeWidth=1.6;strokeColor=#6B4FBB;fontSize=10;fontColor=#6B4FBB;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.75;entryDx=0;entryDy=0;" edge="1" parent="1" source="n9" target="n10"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n14" value="&lt;b&gt;Path A&lt;/b&gt; · customer test cases&lt;br&gt;(questions + expected answers)" style="fontFamily=Segoe UI;rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#6B4FBB;strokeWidth=1;fontColor=#6B4FBB;fontSize=10;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="684" y="120" width="206" height="44" as="geometry"/></mxCell><mxCell id="n15" value="&lt;b&gt;★ Path B&lt;/b&gt; · no test cases yet:&lt;br&gt;ASSERT drafts them from plain language" style="fontFamily=Segoe UI;rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#FFF7E0;strokeColor=#B7791F;strokeWidth=1;fontColor=#B7791F;fontSize=10;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="684" y="180" width="206" height="44" as="geometry"/></mxCell><mxCell id="n16" value="" style="fontFamily=Segoe UI;edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=blockThin;endFill=1;endSize=7;strokeWidth=1.6;strokeColor=#6B4FBB;fontSize=10;fontColor=#6B4FBB;labelBackgroundColor=#ffffff;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.3;entryDx=0;entryDy=0;" edge="1" parent="1" source="n14" target="n10"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n17" value="reviewed by a person" style="fontFamily=Segoe UI;edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=blockThin;endFill=1;endSize=7;strokeWidth=1.6;strokeColor=#B7791F;fontSize=10;fontColor=#B7791F;labelBackgroundColor=#ffffff;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.75;entryDx=0;entryDy=0;" edge="1" parent="1" source="n15" target="n10"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n18" value="&lt;div style=&quot;text-align:left&quot;&gt;&lt;b style=&quot;color:#6B4FBB;font-size:13px&quot;&gt;Customer rules file (policy.json)&lt;/b&gt;&lt;div style=&quot;color:#5B6472;font-size:11px;line-height:1.35;margin-top:4px&quot;&gt;Each customer sets their own rules; the engine is the same for everyone.&lt;br&gt;• &lt;b&gt;Residency&lt;/b&gt;: allowed regions + model deployment types (Regional / Data Zone / Global)&lt;br&gt;• &lt;b&gt;Safety&lt;/b&gt;: content filters + Prompt Shields required&lt;br&gt;• &lt;b&gt;Security&lt;/b&gt;: no key auth, no public network access&lt;br&gt;• Presets: &lt;i&gt;Canada strict · EU data zone · US standard · Permissive&lt;/i&gt; · each rule = &lt;b&gt;block&lt;/b&gt; or &lt;b&gt;warn&lt;/b&gt;&lt;/div&gt;&lt;/div&gt;" style="fontFamily=Segoe UI;rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#6B4FBB;strokeWidth=1.2;shadow=1;align=left;verticalAlign=top;spacingLeft=14;spacingTop=10;spacingRight=10;" vertex="1" parent="1"><mxGeometry x="916" y="104" width="438" height="152" as="geometry"/></mxCell><mxCell id="n19" value="★ new" style="fontFamily=Segoe UI;rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#FFF7E0;strokeColor=#B7791F;strokeWidth=1;fontColor=#B7791F;fontSize=10;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1292" y="94" width="54" height="20" as="geometry"/></mxCell><mxCell id="n20" value="" style="fontFamily=Segoe UI;rounded=1;arcSize=3;fillColor=#EEF4FC;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="30" y="286" width="1340" height="170" as="geometry"/></mxCell><mxCell id="n21" value="" style="fontFamily=Segoe UI;rounded=0;fillColor=#2B6CB0;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="30" y="286" width="6" height="170" as="geometry"/></mxCell><mxCell id="n22" value="&lt;div style=&quot;text-align:left&quot;&gt;&lt;span style=&quot;color:#2B6CB0;font-size:26px;font-weight:300&quot;&gt;2&lt;/span&gt;&lt;br&gt;&lt;b style=&quot;color:#1F2937;font-size:14px&quot;&gt;Build &amp; test in dev&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;color:#5B6472;font-size:11px&quot;&gt;Every merge to main · automatic&lt;/span&gt;&lt;/div&gt;" style="fontFamily=Segoe UI;text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="48" y="300" width="150" height="142" as="geometry"/></mxCell><mxCell id="n23" value="&lt;div style=&quot;text-align:left&quot;&gt;&lt;b style=&quot;color:#2B6CB0;font-size:13px&quot;&gt;Merge to main&lt;/b&gt;&lt;div style=&quot;color:#5B6472;font-size:11px;line-height:1.35;margin-top:4px&quot;&gt;Starts automatically&lt;br&gt;Docs-only changes skip&lt;br&gt;Unchanged results reused&lt;/div&gt;&lt;/div&gt;" style="fontFamily=Segoe UI;rounded=1;arcSize=10;whiteSpace=wrap;html=1;f