CEC;strokeColor=#C53030;strokeWidth=1;fontColor=#C53030;fontSize=10;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="934" y="840" width="170" height="24" as="geometry"/></mxCell><mxCell id="n79" value="feedback loop" style="fontFamily=Segoe UI;edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=blockThin;endFill=1;endSize=7;strokeWidth=1.6;strokeColor=#B7791F;fontSize=10;fontColor=#B7791F;labelBackgroundColor=#ffffff;dashed=1;dashPattern=6 4;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="n69" target="n9"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="208" y="783.0"/><mxPoint x="208" y="222"/></Array></mxGeometry></mxCell><mxCell id="n80" value="&lt;div style=&quot;text-align:left&quot;&gt;&lt;b style=&quot;color:#1F2937;font-size:13px&quot;&gt;Roles&lt;/b&gt;&lt;div style=&quot;color:#5B6472;font-size:11px;line-height:1.4&quot;&gt;&lt;div style=&quot;margin-top:5px&quot;&gt;&lt;b&gt;Author&lt;/b&gt; changes the agent (PR) · &lt;b&gt;Reviewer&lt;/b&gt; approves the PR&lt;/div&gt;&lt;div style=&quot;margin-top:5px&quot;&gt;&lt;b&gt;QA&lt;/b&gt; · &lt;b&gt;Business owner&lt;/b&gt; (UAT) · &lt;b&gt;RAI reviewer&lt;/b&gt; sign off in test&lt;/div&gt;&lt;div style=&quot;margin-top:5px&quot;&gt;&lt;b&gt;Release manager&lt;/b&gt; approves prod&lt;/div&gt;&lt;div style=&quot;margin-top:5px&quot;&gt;Small teams can combine roles; nobody signs off their own change&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;" style="fontFamily=Segoe UI;rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#E2E6EC;strokeWidth=1;shadow=1;align=left;verticalAlign=top;spacingLeft=16;spacingTop=12;spacingRight=12;" vertex="1" parent="1"><mxGeometry x="30" y="896" width="438" height="150" as="geometry"/></mxCell><mxCell id="n81" value="&lt;div style=&quot;text-align:left&quot;&gt;&lt;b style=&quot;color:#1F2937;font-size:13px&quot;&gt;What each new check catches&lt;/b&gt;&lt;div style=&quot;color:#5B6472;font-size:11px;line-height:1.4&quot;&gt;&lt;div style=&quot;margin-top:5px&quot;&gt;&lt;b&gt;G2 rules&lt;/b&gt;: data processed in the wrong country, filters off&lt;/div&gt;&lt;div style=&quot;margin-top:5px&quot;&gt;&lt;b&gt;G4 personas&lt;/b&gt;: the right answer shown to the wrong person&lt;/div&gt;&lt;div style=&quot;margin-top:5px&quot;&gt;&lt;b&gt;RAI checks&lt;/b&gt;: personal data leaks, made-up answers&lt;/div&gt;&lt;div style=&quot;margin-top:5px&quot;&gt;&lt;b&gt;UAT&lt;/b&gt;: correct but not useful (Foundry human-eval evidence)&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;" style="fontFamily=Segoe UI;rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#E2E6EC;strokeWidth=1;shadow=1;align=left;verticalAlign=top;spacingLeft=16;spacingTop=12;spacingRight=12;" vertex="1" parent="1"><mxGeometry x="481" y="896" width="438" height="150" as="geometry"/></mxCell><mxCell id="n82" value="&lt;div style=&quot;text-align:left&quot;&gt;&lt;b style=&quot;color:#1F2937;font-size:13px&quot;&gt;Same as today&lt;/b&gt;&lt;div style=&quot;color:#5B6472;font-size:11px;line-height:1.4&quot;&gt;&lt;div style=&quot;margin-top:5px&quot;&gt;Fail closed: errors or missing results block, never pass&lt;/div&gt;&lt;div style=&quot;margin-top:5px&quot;&gt;A real miss is not retried; judge errors are re-scored (max 2)&lt;/div&gt;&lt;div style=&quot;margin-top:5px&quot;&gt;Results reused when nothing changed (dev version, eval, red team)&lt;/div&gt;&lt;div style=&quot;margin-top:5px&quot;&gt;OIDC login, pinned actions, tag rules, no admin bypass&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;" style="fontFamily=Segoe UI;rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#E2E6EC;strokeWidth=1;shadow=1;align=left;verticalAlign=top;spacingLeft=16;spacingTop=12;spacingRight=12;" vertex="1" parent="1"><mxGeometry x="932" y="896" width="438" height="150" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>